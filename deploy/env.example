MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=evalforge
MYSQL_PASSWORD=evalforge
MYSQL_DATABASE=evalforge
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com

# LLM（OpenAI 兼容 API，用于 M02 EIU 抽取 / 后续题目生成）
# LLM_API_KEY 为占位符 "sk-xxx" 或未安装 openai 时，M02 自动降级为离线确定性抽取
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ---- P0 安全加固（默认关闭/宽松，生产必须调整）----
# API_TOKEN：设置后所有 /api/* 请求需带 `Authorization: Bearer <token>` 或 `X-API-Token`，否则 401。
#   留空 = Demo 无鉴权模式（本地联调用）；生产必须设置强随机值。
# API_TOKEN=
# CORS_ORIGINS：前端经 nginx 同源代理（8080）时无需跨域；直连后端/局域网访问需在此追加来源。
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# 解析资源上限（压缩炸弹防护）：PDF 页数 / 表格行数 / 单元格数 / DOCX 元素数
MAX_PDF_PAGES=500
MAX_TABLE_ROWS=100000
MAX_XLSX_CELLS=500000
MAX_DOCX_BLOCKS=200000
